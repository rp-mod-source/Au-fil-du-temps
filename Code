                    document.getElementById('roulette-status').innerText = `Gagné (${result})`;
                    playSfx('win'); recordCasinoGame('Roulette', bet, true, win);
                } else {
                    document.getElementById('roulette-status').innerText = `Perdu (${result})`;
                    recordCasinoGame('Roulette', bet, false, 0);
                }
                rouletteLocked = false;
                document.getElementById('roulette-rouge-btn').disabled = false;
                document.getElementById('roulette-noir-btn').disabled = false;
            }, 500);
        }

        /* ============================================================
           JEU DU DÉ
           ============================================================ */
        let diceLocked = false;
        async function playDice() {
            if (diceLocked) return;
            const bet = readBet('dice-bet', GAME_RULES.minBetDice);
            if (bet === null || !currentUser || (currentUser.jetons || 0) < bet) { showToast(`Solde insuffisant ou mise < ${GAME_RULES.minBetDice}.`, 'error'); return; }
            const choice = parseInt(document.getElementById('dice-choice').value, 10);

            diceLocked = true;

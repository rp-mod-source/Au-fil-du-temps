        async function initApp() {
            if (!isFirebaseConfigured) {
                document.getElementById('fb-config-banner').style.display = 'block';
                setFirebaseStatus('offline', 'Firebase non configuré');
            } else {
                setFirebaseStatus(null, 'Connexion...');
                try {
                    attachListeners();
                    setFirebaseStatus('online', 'En ligne');
                } catch (e) {
                    console.error(e);
                    setFirebaseStatus('offline', 'Hors ligne');
                    showToast("Connexion à Firebase impossible. Vérifie ta configuration et ta connexion.", 'error');
                }
            }

            const savedId = localStorage.getItem(SESSION_KEY);
            if (savedId && db) {
                try {
                    const snap = await getDoc(doc(db, COLLECTIONS.users, savedId));
                    if (snap.exists()) { currentUser = { id: snap.id, ...snap.data() }; }
                    else { localStorage.removeItem(SESSION_KEY); }
                } catch (e) { console.warn('Session non restaurée :', e); }
            }
            checkAuthUI();

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal').forEach(m => { if (m.style.display === 'flex') closeModal(m.id); });
                }
            });
        }

        function switchTab(tabId) {
            document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            document.querySelectorAll('nav a').forEach(l => {
                if (l.getAttribute('onclick') && l.getAttribute('onclick').includes(tabId)) { l.classList.add('active'); }
            });
            if (tabId === 'casino') { backToLobby(); }
        }


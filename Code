                    document.getElementById('dice-status').innerText = `Perdu ! Le dé a fait ${result}.`;
                    recordCasinoGame('Le Dé', bet, false, 0);
                }
                diceLocked = false;
                document.getElementById('dice-play-btn').disabled = false;
            }, 500);
        }

        /* ============================================================
           EXPOSITION AU SCOPE GLOBAL
           Une balise script de type module a son propre scope : les fonctions
           appelées depuis les attributs onclick/onsubmit du HTML doivent
           être explicitement attachées à window pour rester accessibles.
           ============================================================ */
        Object.assign(window, {
            switchTab, enterClubDancefloor, openModal, closeModal, handleOverlayClick,

    <script type="module">
        'use strict';

        /* ============================================================
           FIREBASE : IMPORTS & CONFIGURATION
           ============================================================ */
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import {
            getFirestore, collection, doc, setDoc, getDoc, updateDoc, deleteDoc,
            onSnapshot, addDoc, query, orderBy, limit, increment, runTransaction,
            enableNetwork, disableNetwork
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        // Remplace ces valeurs par celles de TON projet Firebase
        // (Console Firebase → Paramètres du projet → Vos applications → Config SDK)
        const firebaseConfig = {
            apiKey: "VOTRE_API_KEY",
            authDomain: "VOTRE_AUTH_DOMAIN",
            projectId: "VOTRE_PROJECT_ID",
            storageBucket: "VOTRE_STORAGE_BUCKET",
            messagingSenderId: "VOTRE_MESSAGING_SENDER_ID",
            appId: "VOTRE_APP_ID"
        };

        const isFirebaseConfigured = !Object.values(firebaseConfig).some(v => typeof v === 'string' && v.startsWith('VOTRE_'));

        let app = null, db = null;
        if (isFirebaseConfigured) {
            try {
                app = initializeApp(firebaseConfig);
                db = getFirestore(app);
            } catch (e) {
                console.error("Échec de l'initialisation Firebase :", e);
            }
        }

        const COLLECTIONS = {
            users: 'users',
            menu: 'menu',
            orders: 'commandesRestaurant',
            vipRequests: 'vipRequests',
            history: 'casinoHistory',
            liveBets: 'liveBets'
        };
        const POKER_TABLE_PATH = ['pokerTables', 'table1'];

        const GAME_RULES = {
            minBetDefault: 100,
            minBetDice: 150,
            diceMultiplier: 5,
            slotJackpotMultiplier: 5,
            slotMinorMultiplier: 1.5,
            blackjackPayout: 2.5,
            rouletteMultiplier: 2,
            vipPriceTokens: 1500,
            vipPriceCash: '1000 €',
            pokerMinPlayers: 2,
            pokerMaxPlayers: 8,
            pokerRaiseAmount: 100,
            pokerBlind: 50,
            welcomeJetons: 2000,
            liveBetsCap: 20,
            historyCap: 30
        };

        const SESSION_KEY = 'aft_current_user_id'; // pointeur local : qui est connecté sur CET appareil

        /* ============================================================
           UTILITAIRES
           ============================================================ */
        function escapeHtml(value) {
            const str = (value === null || value === undefined) ? '' : String(value);
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function toSlugPart(str) {
            return String(str || '')
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .toLowerCase().trim()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/(^-+|-+$)/g, '') || 'x';
        }
        function userSlug(prenom, nom) { return `${toSlugPart(prenom)}_${toSlugPart(nom)}`; }

        async function hashText(text) {
            try {
                if (window.crypto && window.crypto.subtle) {
                    const enc = new TextEncoder().encode(text);
                    const digest = await window.crypto.subtle.digest('SHA-256', enc);
                    return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, '0')).join('');
                }
            } catch (e) { console.warn('Hachage indisponible, repli sur texte brut (contexte non sécurisé ?)', e); }
            return 'plain:' + text; // repli si crypto.subtle indisponible (contexte non-HTTPS)
        }

        function showToast(message, type) {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'toast' + (type ? ' ' + type : '');
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => { toast.classList.add('leaving'); setTimeout(() => toast.remove(), 250); }, 3800);
        }

        function setFirebaseStatus(state, text) {
            const el = document.getElementById('fb-status');
            const label = document.getElementById('fb-status-text');
            if (!el || !label) return;
            el.classList.remove('online', 'offline');
            if (state) el.classList.add(state);
            label.textContent = text;
        }

        /* ============================================================
           ÉTAT LOCAL (miroir des données Firestore, tenu à jour par onSnapshot)
           ============================================================ */
        let users = [];
        let menuItems = [];
        let orders = [];
        let vipRequests = [];
        let casinoHistory = [];
        let liveBets = [];
        let leaderboard = [];
        let pokerTable = { players: [], pot: 0, status: 'attente' };
        let currentUser = null;

        function findUserById(id) { return users.find(u => u && u.id === id); }
        function findUserByNomPrenom(nom, prenom) {
            const slug = userSlug(prenom, nom);
            return users.find(u => u && u.id === slug);
        }
        function findDishById(id) { return menuItems.find(item => item && item.id === id); }

        function refreshCurrentUserFromUsers() {
            if (!currentUser) return;
            const fresh = findUserById(currentUser.id);
            if (fresh) { currentUser = fresh; checkAuthUI(); }
        }

        /* ============================================================
           COUCHE FIRESTORE
           ============================================================ */
        function requireDb() {
            if (!db) { showToast("Firebase n'est pas configuré : impossible de contacter le serveur.", 'error'); return false; }
            return true;
        }

        async function fbGetUser(slug) {
            const snap = await getDoc(doc(db, COLLECTIONS.users, slug));
            return snap.exists() ? { id: snap.id, ...snap.data() } : null;
        }

        async function fbCreateUser(slug, data) { await setDoc(doc(db, COLLECTIONS.users, slug), data); }
        async function fbUpdateUser(slug, fields) { await updateDoc(doc(db, COLLECTIONS.users, slug), fields); }

        async function fbAddOrder(data) { await addDoc(collection(db, COLLECTIONS.orders), data); }
        async function fbDeleteOrder(id) { await deleteDoc(doc(db, COLLECTIONS.orders, id)); }

        async function fbAddVipRequest(data) { await addDoc(collection(db, COLLECTIONS.vipRequests), data); }
        async function fbDeleteVipRequest(id) { await deleteDoc(doc(db, COLLECTIONS.vipRequests, id)); }

        async function fbAddMenuItem(data) { await addDoc(collection(db, COLLECTIONS.menu), data); }

        async function fbAddHistoryAndTrim(entry) {
            await addDoc(collection(db, COLLECTIONS.history), entry);
            trimCollection(COLLECTIONS.history, 'timestamp', GAME_RULES.historyCap);
        }
        async function fbAddLiveBetAndTrim(entry) {
            await addDoc(collection(db, COLLECTIONS.liveBets), entry);
            trimCollection(COLLECTIONS.liveBets, 'timestamp', GAME_RULES.liveBetsCap);
        }
        async function trimCollection(collectionName, field, cap) {
            try {
                const q = query(collection(db, collectionName), orderBy(field, 'desc'), limit(cap + 15));
                const snap = await new Promise((resolve, reject) => {
                    const unsub = onSnapshot(q, s => { unsub(); resolve(s); }, reject);
                });
                const docs = snap.docs;
                if (docs.length > cap) {
                    const toDelete = docs.slice(cap);
                    await Promise.all(toDelete.map(d => deleteDoc(d.ref).catch(() => {})));
                }
            } catch (e) { /* nettoyage best-effort, non bloquant */ }
        }

        /* ============================================================
           ÉCOUTEURS TEMPS RÉEL
           ============================================================ */
        function attachListeners() {
            onSnapshot(collection(db, COLLECTIONS.users), snap => {
                users = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderAdminUsers();
                refreshCurrentUserFromUsers();
            }, err => console.error('Écoute users:', err));

            onSnapshot(query(collection(db, COLLECTIONS.users), orderBy('jetons', 'desc'), limit(10)), snap => {
                leaderboard = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderLeaderboard();
            }, err => console.error('Écoute classement:', err));

            onSnapshot(collection(db, COLLECTIONS.menu), snap => {
                menuItems = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderMenu();
            }, err => console.error('Écoute menu:', err));

            onSnapshot(query(collection(db, COLLECTIONS.orders), orderBy('timestamp', 'asc')), snap => {
                orders = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderAdminOrders();
            }, err => console.error('Écoute commandes:', err));

            onSnapshot(query(collection(db, COLLECTIONS.vipRequests), orderBy('timestamp', 'asc')), snap => {
                vipRequests = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderAdminVipRequests();
            }, err => console.error('Écoute VIP:', err));

            onSnapshot(query(collection(db, COLLECTIONS.history), orderBy('timestamp', 'desc'), limit(GAME_RULES.historyCap)), snap => {
                casinoHistory = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderCasinoHistory();
            }, err => console.error('Écoute historique:', err));

            onSnapshot(query(collection(db, COLLECTIONS.liveBets), orderBy('timestamp', 'desc'), limit(GAME_RULES.liveBetsCap)), snap => {
                liveBets = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                renderLiveBets();
            }, err => console.error('Écoute mises en direct:', err));

            onSnapshot(doc(db, ...POKER_TABLE_PATH), snap => {
                pokerTable = snap.exists() ? snap.data() : { players: [], pot: 0, status: 'attente' };
                renderPokerTable();
            }, err => console.error('Écoute poker:', err));
        }


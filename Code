        async function createOrJoinPokerTable() {
            if (!currentUser) { showToast("Connectez-vous pour jouer.", 'error'); openModal('loginModal'); return; }
            if (!requireDb()) return;

            const buyin = parseInt(document.getElementById('poker-buyin').value, 10) || 200;
            const tableRef = doc(db, ...POKER_TABLE_PATH);

            try {
                await runTransaction(db, async (tx) => {
                    const snap = await tx.get(tableRef);
                    const table = snap.exists() ? snap.data() : { players: [], pot: 0, status: 'attente' };

                    if (table.players.some(p => p.nom === currentUser.nom && p.prenom === currentUser.prenom)) {
                        return; // déjà assis
                    }
                    if (table.players.length >= GAME_RULES.pokerMaxPlayers) {
                        throw new Error('TABLE_PLEINE');
                    }
                    if (!currentUser.jetons || currentUser.jetons < buyin) {
                        throw new Error('SOLDE_INSUFFISANT');
                    }

                    const userRef = doc(db, COLLECTIONS.users, currentUser.id);
                    tx.update(userRef, { jetons: increment(-buyin) });
                    table.players.push({ nom: currentUser.nom, prenom: currentUser.prenom, stack: buyin, folded: false });
                    tx.set(tableRef, table);
                });

                currentUser.jetons -= buyin;
                checkAuthUI();
                document.getElementById('poker-setup').style.display = 'none';
                document.getElementById('poker-board').style.display = 'block';
                playSfx('card');
                recordLiveBet('Poker Texas', buyin, "Achat de tapis (Buy-in)");
            } catch (err) {
                if (err.message === 'TABLE_PLEINE') showToast(`La table est complète (maximum ${GAME_RULES.pokerMaxPlayers} joueurs).`, 'error');
                else if (err.message === 'SOLDE_INSUFFISANT') showToast("Solde insuffisant pour payer la mise d'entrée !", 'error');
                else { console.error(err); showToast("Erreur lors de la connexion à la table.", 'error'); }
            }
        }

        function renderPokerTable() {
            const countElem = document.getElementById('poker-players-count');
            const potElem = document.getElementById('poker-pot');
            if (!countElem || !potElem) return;

            countElem.innerText = pokerTable.players.length;
            potElem.innerText = pokerTable.pot + " Jetons";

            const seatsContainer = document.getElementById('poker-seats-list');
            seatsContainer.innerHTML = pokerTable.players.map(p => `
                <div style="background: rgba(255,255,255,0.05); border: 1px solid ${p.folded ? 'var(--danger)' : 'var(--glass-border)'}; padding: 8px 12px; border-radius: 6px; text-align:center; min-width: 100px;">
                    <div style="font-size:0.75rem; color:var(--gold-light);">${escapeHtml(p.prenom)} ${escapeHtml(p.nom)}</div>
                    <div style="font-size:0.9rem; font-weight:bold; color:#fff;">${p.stack} pts</div>
                    ${p.folded ? '<span style="font-size:0.6rem; color:var(--danger);">Couché</span>' : ''}
                </div>`).join('');

            const isPlayerSeated = currentUser && pokerTable.players.some(p => p.nom === currentUser.nom && p.prenom === currentUser.prenom);
            if (isPlayerSeated) {
                document.getElementById('poker-setup').style.display = 'none';
                document.getElementById('poker-board').style.display = 'block';
            }

            if (pokerTable.players.length >= GAME_RULES.pokerMinPlayers && pokerTable.status === 'attente') {
                document.getElementById('poker-start-btn').style.display = 'block';
                document.getElementById('poker-actions').style.display = 'none';
                document.getElementById('poker-room-status').innerText = "Prêt à démarrer ! En attente du lancement.";
            } else if (pokerTable.players.length < GAME_RULES.pokerMinPlayers) {
                document.getElementById('poker-start-btn').style.display = 'none';
                document.getElementById('poker-actions').style.display = 'none';
                document.getElementById('poker-room-status').innerText = `En attente d'autres joueurs (minimum ${GAME_RULES.pokerMinPlayers} requis)...`;
            } else if (pokerTable.status === 'en_cours') {
                document.getElementById('poker-start-btn').style.display = 'none';
                document.getElementById('poker-actions').style.display = 'flex';
                document.getElementById('poker-room-status').innerText = "Manche de Poker en cours ! Faites vos choix.";
            }
        }

        async function startPokerHand() {
            if (!requireDb()) return;
            const tableRef = doc(db, ...POKER_TABLE_PATH);
            try {
                await runTransaction(db, async (tx) => {
                    const snap = await tx.get(tableRef);
                    const table = snap.exists() ? snap.data() : { players: [], pot: 0, status: 'attente' };
                    table.status = 'en_cours';
                    table.pot = table.players.length * GAME_RULES.pokerBlind;
                    table.players = table.players.map(p => ({ ...p, stack: p.stack - GAME_RULES.pokerBlind, folded: false }));
                    tx.set(tableRef, table);
                });
                playSfx('card');
                recordLiveBet('Poker Texas', GAME_RULES.pokerBlind, 'Blinde initiale');
            } catch (e) { console.error(e); showToast("Erreur lors du lancement de la manche.", 'error'); }
        }

        async function pokerAction(actionType) {
            if (!currentUser || !requireDb()) return;
            const tableRef = doc(db, ...POKER_TABLE_PATH);
            let outcome = null;

            try {
                await runTransaction(db, async (tx) => {
                    const snap = await tx.get(tableRef);
                    const table = snap.exists() ? snap.data() : { players: [], pot: 0, status: 'attente' };
                    const players = table.players.map(p => ({ ...p }));
                    const player = players.find(p => p.nom === currentUser.nom && p.prenom === currentUser.prenom);
                    if (!player) return;

                    if (actionType === 'relancer') {
                        if (player.stack < GAME_RULES.pokerRaiseAmount) { outcome = 'INSUFFISANT'; return; }
                        player.stack -= GAME_RULES.pokerRaiseAmount;
                        table.pot += GAME_RULES.pokerRaiseAmount;
                        outcome = 'relance';
                    } else if (actionType === 'passer') {
                        player.folded = true;
                        outcome = 'couche';
                    } else {
                        outcome = 'suivre';
                    }

                    const activePlayers = players.filter(p => !p.folded);
                    if (activePlayers.length === 1) {
                        const winner = activePlayers[0];
                        winner.stack += table.pot;
                        const winnerUser = findUserByNomPrenom(winner.nom, winner.prenom);
                        if (winnerUser) { tx.update(doc(db, COLLECTIONS.users, winnerUser.id), { jetons: increment(table.pot) }); }
                        outcome = { type: 'victoire', winner: winner.prenom, pot: table.pot };
                        table.pot = 0;
                        table.status = 'attente';
                    }

                    table.players = players;
                    tx.set(tableRef, table);
                });

                playSfx('card');
                if (outcome === 'INSUFFISANT') { showToast("Jetons insuffisants pour relancer.", 'error'); return; }
                if (outcome === 'relance') { recordLiveBet('Poker Texas', GAME_RULES.pokerRaiseAmount, 'Relance'); showToast(`Vous avez relancé de ${GAME_RULES.pokerRaiseAmount} jetons !`, 'success'); }
                else if (outcome === 'couche') { showToast("Vous vous êtes couché pour cette manche."); }
                else if (outcome === 'suivre') { showToast("Vous avez suivi l'action."); }
                else if (outcome && outcome.type === 'victoire') {
                    playSfx('win');
                    showToast(`🏆 ${outcome.winner} remporte la manche et gagne ${outcome.pot} jetons !`, 'success');
                }
            } catch (e) { console.error(e); showToast("Erreur lors de l'action.", 'error'); }
        }

        /* ============================================================
           SYSTÈME AUDIO (Web Audio API — inchangé, aucune donnée partagée)
           ============================================================ */
        let audioCtx = null;
        let isCasinoAudioPlaying = false;
        let casinoAmbienceInterval = null;

        function initAudioContext() {
            if (!audioCtx) {
                const AudioCtor = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtor) return;
                audioCtx = new AudioCtor();
            }
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        function toggleCasinoAudio() {
            initAudioContext();
            isCasinoAudioPlaying = !isCasinoAudioPlaying;
            const btn = document.getElementById('audio-toggle-btn');
            const icon = document.getElementById('audio-icon');
            if (isCasinoAudioPlaying) {
                btn.innerText = "Couper Musique"; btn.style.borderColor = "var(--success)"; btn.style.color = "var(--success)"; icon.innerText = "🔊";
                startCasinoAmbience();
            } else {
                btn.innerText = "Activer Musique"; btn.style.borderColor = "var(--gold-primary)"; btn.style.color = "var(--gold-primary)"; icon.innerText = "🎵";
                stopCasinoAmbience();
            }
        }
        function startCasinoAmbience() {
            if (casinoAmbienceInterval) clearInterval(casinoAmbienceInterval);
            const chords = [261.63, 329.63, 392.00, 523.25, 440.00, 349.23];
            playAmbientChord();
            casinoAmbienceInterval = setInterval(() => { if (isCasinoAudioPlaying) playAmbientChord(chords[Math.floor(Math.random() * chords.length)]); }, 4500);
        }
        function stopCasinoAmbience() { if (casinoAmbienceInterval) { clearInterval(casinoAmbienceInterval); casinoAmbienceInterval = null; } }
        function playAmbientChord(freq = 261.63) {
            if (!audioCtx || !isCasinoAudioPlaying) return;
            try {
                const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
                osc.type = 'sine'; osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.03, audioCtx.currentTime + 1.5);
                gain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 4);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(); osc.stop(audioCtx.currentTime + 4.2);
            } catch (e) {}
        }
        function playSfx(type) {
            initAudioContext();
            if (!audioCtx) return;
            try {
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
                osc.connect(gain); gain.connect(audioCtx.destination);
                if (type === 'card') {
                    osc.type = 'triangle'; osc.frequency.setValueAtTime(600, now); osc.frequency.exponentialRampToValueAtTime(200, now + 0.08);
                    gain.gain.setValueAtTime(0.15, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now); osc.stop(now + 0.09);
                } else if (type === 'roulette') {
                    for (let i = 0; i < 12; i++) {
                        const t = now + (i * 0.06);
                        const o = audioCtx.createOscillator(), g = audioCtx.createGain();
                        o.type = 'sine'; o.frequency.setValueAtTime(800 + (Math.random() * 200), t);
                        g.gain.setValueAtTime(0.05, t); g.gain.linearRampToValueAtTime(0.001, t + 0.05);
                        o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t + 0.06);
                    }
                } else if (type === 'slot') {
                    osc.type = 'square'; osc.frequency.setValueAtTime(150, now); osc.frequency.linearRampToValueAtTime(350, now + 0.15);
                    gain.gain.setValueAtTime(0.08, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
                    osc.start(now); osc.stop(now + 0.16);
                } else if (type === 'win') {
                    [523.25, 659.25, 783.99, 1046.50].forEach((noteFreq, index) => {
                        const t = now + (index * 0.1);
                        const o = audioCtx.createOscillator(), g = audioCtx.createGain();
                        o.type = 'sine'; o.frequency.setValueAtTime(noteFreq, t);
                        g.gain.setValueAtTime(0.1, t); g.gain.linearRampToValueAtTime(0.01, t + 0.2);
                        o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t + 0.22);
                    });
                } else if (type === 'dice') {
                    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(300, now); osc.frequency.exponentialRampToValueAtTime(80, now + 0.12);
                    gain.gain.setValueAtTime(0.12, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.12);
                    osc.start(now); osc.stop(now + 0.13);
                }
            } catch (e) {}
        }


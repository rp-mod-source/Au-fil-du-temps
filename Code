<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Au Fil du Temps | Complexe de Luxe</title>
    <!-- Importation sécurisée des polices -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-base: #07070a;
            --bg-surface: rgba(20, 22, 28, 0.85);
            --bg-surface-hover: rgba(30, 33, 42, 0.95);
            --gold-primary: #d4af37;
            --gold-light: #f3e5ab;
            --gold-dark: #997a00;
            --text-main: #f8f8f8;
            --text-muted: #a0a5b1;
            --danger: #ff4757;
            --success: #2ed573;
            --glass-border: rgba(255, 255, 255, 0.08);
            --font-heading: 'Cinzel', serif;
            --font-body: 'Montserrat', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: var(--font-body), sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            background-image: radial-gradient(circle at 50% 0%, #1a1a24 0%, transparent 70%);
        }

        a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
            outline: 2px solid var(--gold-primary);
            outline-offset: 2px;
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
        }

        .sr-only {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
        }

        /* --- HEADER & NAVIGATION --- */
        header {
            background: rgba(7, 7, 10, 0.95);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--glass-border);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            flex-wrap: wrap;
            gap: 15px;
        }

        .logo-container { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

        .logo {
            font-family: var(--font-heading), serif;
            font-size: clamp(1.3rem, 4vw, 1.8rem);
            font-weight: 700;
            color: var(--gold-primary);
            text-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
            letter-spacing: 2px;
        }

        #fb-status {
            font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px;
            padding: 3px 8px; border-radius: 20px; border: 1px solid var(--glass-border);
            color: var(--text-muted); display: inline-flex; align-items: center; gap: 5px;
        }
        #fb-status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); display:inline-block; }
        #fb-status.online { color: var(--success); border-color: var(--success); }
        #fb-status.online .dot { background: var(--success); }
        #fb-status.offline { color: var(--danger); border-color: var(--danger); }
        #fb-status.offline .dot { background: var(--danger); }

        #fb-config-banner {
            display: none; background: rgba(255, 71, 87, 0.12); border-bottom: 1px solid var(--danger);
            color: #ffd7da; text-align: center; font-size: 0.8rem; padding: 10px 15px;
        }

        nav { display: flex; gap: 5px; flex-wrap: wrap; }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 8px 15px;
            border-radius: 4px;
            transition: all 0.4s ease;
            cursor: pointer;
            position: relative;
        }

        nav a:hover, nav a.active { color: var(--gold-primary); background: rgba(212, 175, 55, 0.05); }

        /* --- BOUTONS --- */
        .btn {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
            color: #000;
            border: none;
            padding: 10px 22px;
            border-radius: 4px;
            font-family: var(--font-body), sans-serif;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
            text-align: center;
        }

        .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4); filter: brightness(1.1); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; filter: none; }

        .btn-outline { background: transparent; border: 1px solid var(--gold-primary); color: var(--gold-primary); box-shadow: none; }
        .btn-outline:hover { background: rgba(212, 175, 55, 0.1); color: var(--gold-light); }
        .btn-outline:disabled:hover { background: transparent; color: var(--gold-primary); }
        .btn-danger { background: var(--danger); color: white; }

        /* --- STRUCTURE MAIN --- */
        main { flex: 1; width: 100%; }
        .section { display: none; opacity: 0; transition: opacity 0.4s ease; }
        .section.active { display: block; opacity: 1; }
        .container { max-width: 1400px; margin: 0 auto; padding: 2rem 1rem; }

        /* --- HERO BANNERS --- */
        .hero {
            height: 35vh; min-height: 220px;
            display: flex; align-items: center; justify-content: center; text-align: center;
            position: relative; background-size: cover; background-position: center;
        }
        .hero::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to bottom, rgba(7,7,10,0.6), var(--bg-base));
        }
        .hero-content { position: relative; z-index: 1; max-width: 800px; padding: 0 20px; }
        .hero h1 { font-family: var(--font-heading), serif; font-size: clamp(1.8rem, 6vw, 2.8rem); color: var(--gold-primary); margin-bottom: 10px; text-shadow: 0 5px 15px rgba(0,0,0,0.8); }
        .hero p { font-size: 1rem; color: var(--text-main); font-weight: 300; }

        /* --- CARTES & GRILLES --- */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .card { background: var(--bg-surface); backdrop-filter: blur(10px); border: 1px solid var(--glass-border); border-radius: 12px; padding: 25px; transition: all 0.3s ease; }
        h2, h3 { font-family: var(--font-heading), serif; color: var(--gold-light); margin-bottom: 15px; }

        /* --- RESTAURANT --- */
        .menu-list { display: flex; flex-direction: column; gap: 15px; }
        .menu-item { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 12px; gap: 15px; flex-wrap: wrap; }
        .menu-item-info h4 { font-family: var(--font-heading), serif; font-size: 1.1rem; color: var(--gold-primary); }
        .menu-item-info p { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; font-style: italic; }
        .menu-price { font-family: var(--font-heading), serif; font-size: 1.2rem; color: #fff; font-weight: 700; white-space: nowrap; }

        /* --- CASINO TABLES --- */
        .casino-table {
            background: radial-gradient(circle at center, #0f3d24 0%, #061c10 100%);
            border: 6px solid #2a1610; border-radius: 20px; padding: 30px 20px;
            box-shadow: inset 0 0 40px rgba(0,0,0,0.8), 0 15px 30px rgba(0,0,0,0.5);
            text-align: center;
        }
        .playing-card {
            background: #fff; color: #000; width: 60px; height: 90px; border-radius: 6px;
            display: inline-flex; flex-direction: column; justify-content: space-between;
            padding: 6px; font-weight: bold; font-size: 1.1rem;
            box-shadow: 2px 4px 10px rgba(0,0,0,0.5); margin: 0 4px;
        }
        .playing-card.red { color: #d63031; }

        /* --- LEADERBOARD --- */
        .rank-row { display: flex; align-items: center; gap: 12px; padding: 8px 4px; border-bottom: 1px solid rgba(255,255,255,0.06); }
        .rank-num { font-family: var(--font-heading), serif; color: var(--gold-primary); width: 22px; text-align: center; font-weight: 700; }
        .rank-name { flex: 1; font-size: 0.88rem; }
        .rank-jetons { font-family: var(--font-heading), serif; color: var(--gold-light); font-weight: 700; }

        /* --- FORMS & MODALS --- */
        .form-group { margin-bottom: 15px; text-align: left; }
        .form-group label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 12px; background: rgba(0,0,0,0.5);
            border: 1px solid var(--glass-border); border-radius: 6px;
            color: #fff; font-family: var(--font-body), sans-serif; font-size: 0.95rem;
        }
        .form-group input:focus, .form-group select:focus { border-color: var(--gold-primary); outline: none; }

        .modal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);
            justify-content: center; align-items: center; z-index: 2000; padding: 15px;
        }
        .modal-content {
            background: var(--bg-surface); border: 1px solid var(--glass-border);
            padding: 30px; border-radius: 12px; width: 100%; max-width: 420px;
            position: relative; box-shadow: 0 25px 50px rgba(0,0,0,0.6);
        }

        /* --- ADMIN DASHBOARD --- */
        .admin-row {
            display: flex; justify-content: space-between; align-items: center;
            background: rgba(0,0,0,0.4); padding: 12px 15px; border-radius: 6px; margin-bottom: 8px;
            border-left: 3px solid var(--gold-primary); gap: 10px; flex-wrap: wrap;
        }
        .badge { padding: 3px 8px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
        .badge-employe { background: rgba(46, 213, 115, 0.2); color: var(--success); border: 1px solid var(--success); }
        .badge-vip { background: rgba(212, 175, 55, 0.2); color: var(--gold-light); border: 1px solid var(--gold-primary); }

        footer { text-align: center; padding: 1.5rem; border-top: 1px solid var(--glass-border); font-size: 0.8rem; color: var(--text-muted); }

        /* --- NOTIFICATIONS TOAST --- */
        #toast-container {
            position: fixed; bottom: 20px; right: 20px; z-index: 3000;
            display: flex; flex-direction: column; gap: 10px; max-width: calc(100% - 40px); width: 320px;
        }
        .toast {
            background: var(--bg-surface-hover); border: 1px solid var(--glass-border);
            border-left: 4px solid var(--gold-primary);
            padding: 14px 16px; border-radius: 8px; font-size: 0.85rem; color: var(--text-main);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            animation: toast-in 0.25s ease forwards;
        }
        .toast.success { border-left-color: var(--success); }
        .toast.error { border-left-color: var(--danger); }
        .toast.leaving { animation: toast-out 0.25s ease forwards; }
        @keyframes toast-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes toast-out { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(10px); } }

        /* --- RESPONSIVE : petits écrans --- */
        @media (max-width: 480px) {
            header { padding: 0.75rem 1rem; }
            .container { padding: 1.5rem 0.75rem; }
            .card { padding: 18px; }
            .playing-card { width: 48px; height: 72px; font-size: 0.9rem; }
            #poker-actions { flex-direction: column; }
            #poker-actions .btn { width: 100%; }
            .modal-content { padding: 20px; }
            #toast-container { right: 10px; left: 10px; width: auto; bottom: 10px; }
        }
    </style>
</head>
<body>

    <div id="fb-config-banner">
        ⚠ Firebase n'est pas configuré : remplace les valeurs <code>VOTRE_...</code> dans <code>firebaseConfig</code> (haut du script) par les identifiants de ton projet Firebase pour activer la synchronisation en ligne.
    </div>

    <header>
        <div class="logo-container">
            <div class="logo">AU FIL DU TEMPS</div>
            <span id="fb-status"><span class="dot"></span><span id="fb-status-text">Connexion...</span></span>
        </div>
        <nav aria-label="Navigation principale">
            <a href="javascript:void(0)" onclick="switchTab('restaurant')" class="active">Gastronomie</a>
            <a href="javascript:void(0)" onclick="switchTab('club')">Le Club</a>
            <a href="javascript:void(0)" onclick="switchTab('casino')">Casino</a>
            <a href="javascript:void(0)" onclick="switchTab('employe')" id="nav-employe" style="display:none; color: var(--success);">Administration</a>
        </nav>
        <div class="user-panel" id="user-panel-auth">
            <button type="button" class="btn btn-outline" onclick="openModal('loginModal')">S'identifier</button>
            <button type="button" class="btn" onclick="openModal('registerModal')">Devenir Membre</button>
        </div>
        <div class="user-panel" id="user-panel-logged" style="display: none; align-items: center; gap: 12px;">
            <span id="welcome-user" style="font-weight: 500; font-family: var(--font-heading), serif; color: var(--gold-light); font-size: 0.9rem;"></span>
            <button type="button" class="btn btn-danger" onclick="logout()" style="padding: 6px 12px; font-size: 0.75rem;">Quitter</button>
        </div>
    </header>

    <main>
        <!-- SECTION RESTAURANT -->
        <section id="restaurant" class="section active">
            <div class="hero" style="background-image: url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=1920&q=80');">
                <div class="hero-content">
                    <h1>L'Excellence Culinaire</h1>
                    <p>Découvrez une carte raffinée, pensée par nos chefs étoilés.</p>
                </div>
            </div>

            <div class="container">
                <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
                    <div class="card">
                        <h2 style="text-align: center; margin-bottom: 20px;">Notre Menu Signature</h2>
                        <div class="menu-list" id="menu-grid"></div>
                    </div>

                    <div class="card" style="height: fit-content; border-color: var(--gold-primary);">
                        <h3 style="text-align: center;">Réserver / Commander</h3>
                        <form id="order-form" onsubmit="submitOrder(event)" style="margin-top: 15px;">
                            <div class="form-group">
                                <label id="order-identity-label">Identité (RP)</label>
                                <div style="display:flex; gap:10px;">
                                    <label for="order-prenom" class="sr-only">Prénom</label>
                                    <input type="text" id="order-prenom" required placeholder="Prénom" aria-labelledby="order-identity-label" autocomplete="off">
                                    <label for="order-nom" class="sr-only">Nom</label>
                                    <input type="text" id="order-nom" required placeholder="Nom" aria-labelledby="order-identity-label" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="order-plat">Choix du plat</label>
                                <select id="order-plat" required></select>
                            </div>
                            <button type="submit" class="btn" style="width: 100%;">Transmettre au Chef</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION CLUB -->
        <section id="club" class="section">
            <div class="hero" style="background-image: url('https://images.unsplash.com/photo-1566737236500-c8ac43014a67?auto=format&fit=crop&w=1920&q=80');">
                <div class="hero-content">
                    <h1>Nightclub Élite</h1>
                    <p>La référence nocturne de la ville.</p>
                </div>
            </div>

            <div class="container">
                <div class="grid">
                    <div class="card" style="text-align: center; padding: 40px 20px;">
                        <h2>Accès Général</h2>
                        <p style="color: var(--text-muted); margin-bottom: 20px; font-weight: 300; font-size: 0.9rem;">Dancefloor principal, bar central et sets DJ.</p>
                        <h3 style="color: #fff; margin-bottom: 15px;">Entrée Libre</h3>
                        <button type="button" class="btn btn-outline" onclick="enterClubDancefloor()" style="width:100%;">Rejoindre la piste</button>
                    </div>

                    <div class="card" style="text-align: center; padding: 40px 20px; background: linear-gradient(145deg, rgba(30,25,15,0.9), rgba(15,12,5,0.9)); border: 1px solid var(--gold-primary);">
                        <h2>L'Espace Privilège</h2>
                        <span class="badge badge-vip" style="display:inline-block; margin-bottom: 15px;">1500 Jetons / 1000 €</span>
                        <p style="color: var(--text-muted); margin-bottom: 20px; font-weight: 300; font-size: 0.9rem;">Salons privatifs, hôtesses et service premium.</p>
                        <button type="button" class="btn" onclick="openVipModal()" style="width:100%;">Réserver un Salon VIP</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION CASINO -->
        <section id="casino" class="section">
            <div class="hero" style="background-image: url('https://images.unsplash.com/photo-1596838132731-3301c3fd4317?auto=format&fit=crop&w=1920&q=80');">
                <div class="hero-content">
                    <h1>Le Grand Casino Lounge</h1>
                    <p>Tentez votre chance sur nos tables prestigieuses.</p>
                </div>
            </div>

            <div class="container">
                <!-- Panneau Contrôle Audio Casino -->
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 25px;">
                    <div style="background: rgba(212, 175, 55, 0.1); border: 1px solid var(--gold-primary); padding: 10px 20px; border-radius: 8px; display: inline-flex; align-items: center; gap: 12px;">
                        <span style="font-size: 1.3rem;" aria-hidden="true">🏦</span>
                        <div>
                            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--gold-primary); font-weight: bold;">Fonds Disponibles</div>
                            <div style="font-size: 1.2rem; font-family: var(--font-heading), serif; color: #fff;"><span id="user-points">0</span> Jetons</div>
                        </div>
                    </div>

                    <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--glass-border); padding: 10px 15px; border-radius: 8px; display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 1.1rem;" id="audio-icon" aria-hidden="true">🎵</span>
                        <div style="font-size: 0.85rem; font-weight: 500;">Ambiance Casino</div>
                        <button type="button" class="btn btn-outline" id="audio-toggle-btn" onclick="toggleCasinoAudio()" style="padding: 5px 12px; font-size: 0.75rem;">Activer Musique</button>
                    </div>
                </div>

                <div id="casino-lobby" class="casino-view" style="display:block;">
                    <div class="grid">
                        <div class="card" style="text-align: center;">
                            <h2 style="font-size: 1.3rem;">Blackjack</h2>
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 15px;">Atteignez 21 sans sauter.</p>
                            <button type="button" class="btn btn-outline" onclick="openCasinoGame('blackjack')" style="width:100%;">Prendre Place</button>
                        </div>
                        <div class="card" style="text-align: center;">
                            <h2 style="font-size: 1.3rem;">Roulette</h2>
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 15px;">Faites vos jeux sur la roue.</p>
                            <button type="button" class="btn btn-outline" onclick="openCasinoGame('roulette')" style="width:100%;">Prendre Place</button>
                        </div>
                        <div class="card" style="text-align: center;">
                            <h2 style="font-size: 1.3rem;">Machines à Sous</h2>
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 15px;">Jackpots progressifs.</p>
                            <button type="button" class="btn btn-outline" onclick="openCasinoGame('slots')" style="width:100%;">Tenter sa chance</button>
                        </div>
                        <div class="card" style="text-align: center;">
                            <h2 style="font-size: 1.3rem;">Le Jeu du Dé</h2>
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 15px;">Trouvez le bon numéro (1 à 6).</p>
                            <button type="button" class="btn btn-outline" onclick="openCasinoGame('dice')" style="width:100%;">Lancer les dés</button>
                        </div>
                        <div class="card" style="text-align: center; border-color: var(--gold-primary);">
                            <h2 style="font-size: 1.3rem;">Poker Texas Hold'em</h2>
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 15px;">Affrontez 2 à 8 joueurs en direct.</p>
                            <button type="button" class="btn" onclick="openCasinoGame('poker')" style="width:100%;">Rejoindre le salon</button>
                        </div>
                    </div>

                    <div class="card" style="margin-top: 20px;">
                        <h3>🏆 Classement des Joueurs</h3>
                        <div id="leaderboard-list" style="margin-top: 10px;"></div>
                    </div>
                </div>

                <!-- JEU BLACKJACK -->
                <div id="game-blackjack" class="casino-view" style="display:none;">
                    <button type="button" class="btn-outline" onclick="backToLobby()" style="padding: 6px 12px; margin-bottom: 15px; border-radius:4px; color:#fff; cursor:pointer;">⬅ Quitter la table</button>
                    <div class="casino-table">
                        <h2 style="color: rgba(255,255,255,0.8); letter-spacing: 1px; font-size: 1.2rem;">BLACKJACK PAYS 3 TO 2</h2>
                        <div class="form-group" style="max-width: 180px; margin: 15px auto;">
                            <label for="bj-bet" class="sr-only">Mise</label>
                            <input type="number" id="bj-bet" value="100" min="100" step="1" placeholder="Mise (Min 100)" style="text-align:center;">
                        </div>

                        <div style="min-height: 200px; display:flex; flex-direction:column; justify-content:center;">
                            <div id="bj-dealer-info" style="color: #fff; font-size: 0.9rem; margin-bottom: 10px; font-weight: bold;" aria-live="polite"></div>
                            <div id="bj-player-cards" style="display:flex; justify-content:center; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;"></div>
                            <p id="bj-status" style="font-size: 1rem; color: var(--gold-light);" aria-live="polite"></p>
                        </div>

                        <div style="max-width: 250px; margin: 0 auto;">
                            <button type="button" class="btn" id="bj-start-btn" onclick="startBlackjack()" style="width:100%;">Distribuer</button>

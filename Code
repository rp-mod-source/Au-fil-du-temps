        async function handleRegister(e) {
            e.preventDefault();
            if (!requireDb()) return;
            document.getElementById('reg-error').style.display = 'none';

            const nom = document.getElementById('reg-nom').value.trim();
            const prenom = document.getElementById('reg-prenom').value.trim();
            const pass = document.getElementById('reg-pass').value;
            const code = document.getElementById('reg-code').value;
            const slug = userSlug(prenom, nom);

            const submitBtn = document.getElementById('register-submit-btn');
            submitBtn.disabled = true;
            try {
                const existing = await fbGetUser(slug);
                if (existing) { document.getElementById('reg-error').style.display = 'block'; return; }

                const isEmploye = (code === "Jean Jack 123");
                const passHash = await hashText(pass);
                const newUser = {
                    nom, prenom, passHash,
                    jetons: GAME_RULES.welcomeJetons,
                    employe: isEmploye,
                    isVip: false,
                    dateCreation: new Date().toISOString()
                };
                await fbCreateUser(slug, newUser);

                currentUser = { id: slug, ...newUser };
                localStorage.setItem(SESSION_KEY, slug);

                e.target.reset();
                closeModal('registerModal');
                checkAuthUI();
                showToast(isEmploye ? "Compte Staff créé ! 2000 jetons offerts." : "Bienvenue ! 2000 jetons offerts.", 'success');
            } catch (err) {
                console.error(err);
                showToast("Erreur lors de l'inscription. Vérifie ta connexion.", 'error');
            } finally {
                submitBtn.disabled = false;
            }
        }

        async function handleLogin(e) {
